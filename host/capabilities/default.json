{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and windows spawned for opened files",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
