{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edytka",
  "version": "../package.json",
  "identifier": "com.edytka.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Edytka",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["rs"],
        "name": "Rust Source",
        "role": "Editor"
      },
      {
        "ext": ["kt", "kts"],
        "name": "Kotlin Source",
        "role": "Editor"
      },
      {
        "ext": ["java"],
        "name": "Java Source",
        "role": "Editor"
      },
      {
        "ext": ["cs"],
        "name": "C# Source",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
